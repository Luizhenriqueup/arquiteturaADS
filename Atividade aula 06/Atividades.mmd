    H --> I{Estoque igual a zero?}
    I -- [sim] --> J[Define INDISPONÍVEL]
    I -- [não] --> K[Mantém DISPONÍVEL]
    E --> L[Salva produto]
    J --> L
    K --> L
    L --> Fim(( ))
    C --> Fim
    G --> Fim
